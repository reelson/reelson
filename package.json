{
    "name": "reelkit",
    "version": "0.6.0",
    "private": true,
    "type": "module",
    "description": "Claude Code skills + CLI that turn a scripted Playwright walkthrough into a branded HyperFrames demo video.",
    "bin": {
        "reelkit": "bin/reelkit.ts"
    },
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "setup": "npm install && npx playwright install chromium",
        "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
        "test:update-golden": "UPDATE_GOLDEN=1 node --test \"test/**/*.test.ts\"",
        "typecheck": "tsc --noEmit",
        "ci": "npm run typecheck && npm test",
        "example:verify": "cd examples && node ../bin/reelkit.ts verify todo-add-item",
        "example:record": "cd examples && node ../bin/reelkit.ts record todo-add-item --all-takes",
        "example:build": "cd examples && node ../bin/reelkit.ts build todo-add-item",
        "example:check": "cd examples && node ../bin/reelkit.ts check todo-add-item",
        "example:render": "cd examples && node ../bin/reelkit.ts render todo-add-item --all-formats"
    },
    "dependencies": {
        "@playwright/test": "^1.55.0"
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "typescript": "^5.9.0"
    }
}
